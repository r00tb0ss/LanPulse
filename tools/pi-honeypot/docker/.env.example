# Copy this file to .env and fill it in. Keep .env private: it holds your sensor key.

# Address of your LanPulse server
LANPULSE_URL=https://192.168.0.208:8080

# LanPulse > Honeypot > Settings > "External-sensor key"
LANPULSE_KEY=

# SHA-256 of LanPulse's certificate (it is self-signed). Get it with:
#   openssl s_client -connect 192.168.0.208:8080 </dev/null 2>/dev/null | openssl x509 -noout -fingerprint -sha256
# and paste the part after the "=" (colons are fine). Leave empty only for a plain http:// address.
LANPULSE_FINGERPRINT=

# Name shown in LanPulse for this sensor
SENSOR_NAME=cowrie-container
